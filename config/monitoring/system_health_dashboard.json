"""
ASTRA System Health Dashboard Configuration
Grafana dashboard configuration for monitoring ASTRA core systems
Created: October 21, 2025
"""
{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "System Readiness",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(astra_system_readiness)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Memory Usage by Type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "astra_memory_usage_bytes",
          "legendFormat": "{{memory_type}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "rate(astra_memory_cache_hits_total[5m]) / (rate(astra_memory_cache_hits_total[5m]) + rate(astra_memory_cache_misses_total[5m]))",
          "legendFormat": "{{memory_type}}"
        }
      ]
    },
    {
      "title": "Operation Latency",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(astra_memory_operation_duration_seconds_bucket[5m])",
          "legendFormat": "{{memory_type}} - {{operation_type}}"
        }
      ]
    },
    {
      "title": "Query Complexity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "astra_memory_query_complexity",
          "legendFormat": "{{memory_type}} - {{operation_type}}"
        }
      ]
    },
    {
      "title": "Creator Alignment Score",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "astra_creator_alignment_score",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["astra", "monitoring"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "ASTRA System Health",
  "version": 1,
  "weekStart": ""
}