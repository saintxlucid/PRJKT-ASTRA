# Dockerfile.bridge
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.bridge.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.bridge.txt

# Copy bridge service
COPY src/astra/bridge/tool_bridge_service.py /app/

# Create data directory
RUN mkdir -p /data /data/safe

# Non-root user for security
RUN useradd -m -u 1000 bridge && chown -R bridge:bridge /app /data
USER bridge

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run bridge service
CMD ["python", "-m", "uvicorn", "tool_bridge_service:app", "--host", "0.0.0.0", "--port", "8000"]
