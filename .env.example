# ASTRA Environment Configuration
# Copy this file to .env and customize as needed
# All settings can also be configured in config/default.yaml

# Environment
ASTRA_ENVIRONMENT=development

# Server
ASTRA_SERVER_HOST=0.0.0.0
ASTRA_SERVER_PORT=8080
ASTRA_SERVER_LOG_LEVEL=INFO

# Rate Limiting
ASTRA_PER_KEY_RATE=120  # Requests per period
ASTRA_PER_KEY_PERIOD_SEC=60  # Period in seconds

# Circuit Breaker Configuration
ASTRA_BREAKER_THRESHOLD=5  # Number of failures before opening
ASTRA_BREAKER_RECOVERY_TIME=30  # Recovery time in seconds
ASTRA_BREAKER_TIMEOUT=10  # Request timeout in seconds
ASTRA_BREAKER_HALF_OPEN_CALLS=3  # Max calls in half-open state

# Data and Configuration Paths
ASTRA_DATA=/data  # Base data directory
ASTRA_CONFIG=/app/config/rag.yaml  # Configuration file path
ASTRA_POLICY_PATH=/app/config/policy.yaml  # Policy configuration path

# Audit and Logging
ASTRA_AUDIT_MAX_BYTES=10485760  # 10MB max audit log size

# Security and Authentication
ASTRA_TOKEN_SECRET=dev_secret  # JWT signing secret (change in production)
ASTRA_TOKEN_SECRET_BLOB=  # Optional: Blob storage path for token secret

# LLM Configuration
# Provider and Model Selection
ASTRA_LLM_PROVIDER=llama.cpp
ASTRA_LLM_MODEL_NAME=gpt-oss-20b
ASTRA_LLM_MODEL_SIZE=gpt-oss-20b  # gpt-oss-120b or gpt-oss-20b
ASTRA_LLM_MODEL_PATH=gpt-oss-20b.Q4_K_M.gguf

# Connection Settings
ASTRA_LLM_BASE_URL=http://localhost:8001/v1
# ASTRA_LLM_API_KEY=  # Required for OpenAI/Anthropic

# Model Architecture (GPT-OSS Specifications)
ASTRA_LLM_CONTEXT_LENGTH=131072  # Maximum: 131,072 tokens
ASTRA_LLM_ACTIVE_PARAMETERS=3600000000  # 3.6B for 20b, 5.1B for 120b

# Generation Parameters
ASTRA_LLM_TEMPERATURE=0.7
ASTRA_LLM_MAX_TOKENS=2048

# GPT-OSS Reasoning & Tools
ASTRA_LLM_REASONING_MODE=medium  # low, medium, or high
ASTRA_LLM_USE_HARMONY_FORMAT=true
ASTRA_LLM_ENABLE_BROWSING=false
ASTRA_LLM_ENABLE_PYTHON=false
ASTRA_LLM_ENABLE_DEVELOPER_FUNCTIONS=true
ASTRA_LLM_STRIP_COT_IN_HISTORY=true

# Connection and Reliability
ASTRA_LLM_TIMEOUT=300  # Increased for high reasoning mode
ASTRA_LLM_RETRY_ATTEMPTS=3

# Tokenizer Information
ASTRA_LLM_TOKENIZER_NAME=o200k_harmony
ASTRA_LLM_VOCAB_SIZE=201088

# Database
# SQLite (default)
ASTRA_DATABASE_URL=sqlite:///data/astra.db
# Or PostgreSQL: postgresql://user:password@localhost/astra

# Vector Store
ASTRA_VECTOR_STORE__PERSIST_DIRECTORY=data/chromadb
ASTRA_VECTOR_STORE__COLLECTION_NAME=astra_memory
ASTRA_VECTOR_STORE__DISTANCE_METRIC=cosine

# Memory
ASTRA_MEMORY__EMBEDDING_MODEL=all-MiniLM-L6-v2
ASTRA_MEMORY__TOP_K=5
ASTRA_MEMORY__SIMILARITY_THRESHOLD=0.8

# CORS (comma-separated list)
ASTRA_CORS__ORIGINS=http://localhost:5173,http://localhost:3000

# Security
ASTRA_SECURITY__API_KEY_ENABLED=false
ASTRA_SECURITY__RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# INTELLIGENCE & UPDATES SYSTEM
# ============================================================================

# Updates System - Project awareness and change tracking
ASTRA_UPDATES_ENABLED=true                    # Enable/disable updates system
ASTRA_UPDATES_ANNOUNCE_LEVEL=summary          # silent|summary|verbose

# Bridge Module - External integrations
ASTRA_BRIDGE_ENABLED=true                     # Enable/disable bridge module
ASTRA_BRIDGE_CHROMA_STARTUP_TIMEOUT_MS=3000   # ChromaDB startup timeout (ms)
ASTRA_BRIDGE_MAX_TOOLCALLS_PER_REQ=1          # Tool execution budget per request

# Autonomy Engine - Proactive behavior  
ASTRA_AUTONOMY_ENABLED=true                   # Enable/disable autonomy
ASTRA_AUTONOMY_EXPLAIN=1                      # Emit explanations (0=off, 1=on)

# Feature Flags - Experimental capabilities
ASTRA_VOICE_ENABLED=0                         # Voice interface (0=disabled, 1=enabled)
ASTRA_DAW_OSC_ENABLED=0                       # DAW OSC integration (0=disabled, 1=enabled)

# Mode - Operating context (affects behavior and communication)
ASTRA_MODE=COGNITION                          # NONE|DREAM|MUSIC|COGNITION|EMPIRE
