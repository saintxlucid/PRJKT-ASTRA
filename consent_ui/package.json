{
  "name": "astra-consent-ui",
  "displayName": "ASTRA Consent UI — Sigil Gate",
  "description": "Sacred sovereignty interface for ASTRA OS plan approval and token management",
  "version": "1.0.0",
  "publisher": "astra-os",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:astra.sigilGate.showConsent",
    "onCommand:astra.sigilGate.viewHistory",
    "onCommand:astra.sigilGate.revokeToken"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "astra.sigilGate.showConsent",
        "title": "ASTRA: Show Consent Modal",
        "icon": "$(shield)"
      },
      {
        "command": "astra.sigilGate.viewHistory",
        "title": "ASTRA: View Token History",
        "icon": "$(history)"
      },
      {
        "command": "astra.sigilGate.revokeToken",
        "title": "ASTRA: Revoke Token",
        "icon": "$(close)"
      }
    ],
    "configuration": {
      "title": "ASTRA Sigil Gate",
      "properties": {
        "astra.sigilGate.sigilctlPath": {
          "type": "string",
          "default": "",
          "description": "Path to sigilctl binary (leave empty for auto-detect)"
        },
        "astra.sigilGate.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve low-risk operations (NOT RECOMMENDED)"
        },
        "astra.sigilGate.showBudgetWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings when budget exceeds 80%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && cd webview && npm run build",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "execa": "^8.0.1"
  }
}
