# ===== ASTRA TIER-0 (Voice + Desktop Control) =====
ASTRA_API_KEY=change-me-48chars
ASTRA_PRIVACY_EGRESS=false

# Whisper local model paths (GGML/GGUF or CTranslate2 dir)
ASTRA_WHISPER_MODEL_DIR=./models/whisper-small-int8
ASTRA_WHISPER_DEVICE=cpu          # cpu|cuda
ASTRA_WHISPER_COMPUTE_TYPE=int8   # int8|float16|float32

# Voice
ASTRA_WAKE_ENABLED=true
ASTRA_WAKE_PHRASES="ASTRA awaken; ASTRA initialize; ASTRA come online"
ASTRA_VAD_AGGRESSIVENESS=2        # 0..3 (webrtcvad)
ASTRA_SAMPLE_RATE=16000
ASTRA_MIC_DEVICE_INDEX=default

# Desktop control safety
ASTRA_DESKTOP_ENABLED=true
ASTRA_DESKTOP_ALLOWLIST="focus;launch;tile;type;hotkey;screenshot;close"
ASTRA_SAFE_APPS_DIR=C:\\Program Files\\
