{
  "title": "ASTRA Core",
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Error Rate (5xx / All)",
      "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [
        {"expr": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])),1)"}
      ],
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"}
    },
    {
      "type": "graph",
      "title": "Answer Latency p50/p95",
      "gridPos": {"x":6,"y":0,"w":18,"h":8},
      "targets": [
        {"refId":"A","expr":"histogram_quantile(0.50, sum(rate(astra_answer_latency_seconds_bucket[5m])) by (le))"},
        {"refId":"B","expr":"histogram_quantile(0.95, sum(rate(astra_answer_latency_seconds_bucket[5m])) by (le))"}
      ]
    },
    {
      "type": "gauge",
      "title": "Queue Depth",
      "gridPos": {"x":0,"y":4,"w":6,"h":8},
      "targets": [{"expr": "astra_inference_queue_depth"}],
      "fieldConfig":{"defaults":{"max":200}}
    },
    {
      "type": "graph",
      "title": "Cache Hit Rate",
      "gridPos": {"x":6,"y":8,"w":9,"h":8},
      "targets": [
        {"expr":"sum(rate(astra_cache_hits_total[5m])) / clamp_min(sum(rate(astra_cache_requests_total[5m])),1)"}
      ]
    },
    {
      "type": "graph",
      "title": "RAG Fusion Latency",
      "gridPos": {"x":15,"y":8,"w":9,"h":8},
      "targets": [{"expr":"sum(rate(astra_rag_latency_seconds_sum[5m]))/sum(rate(astra_rag_latency_seconds_count[5m]))"}]
    },
    {
      "type": "graph",
      "title": "Token Budget Utilization",
      "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [{"expr":"avg(astra_token_budget_used / clamp_min(astra_token_budget_limit,1))"}]
    },
    {
      "type": "graph",
      "title": "Unhandled Errors",
      "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [{"expr":"rate(astra_unhandled_errors_total[5m])"}]
    }
  ],
  "schemaVersion": 39
}