# ASTRA 2.0 Configuration

# API Settings
ASTRA_API_HOST=127.0.0.1
ASTRA_API_PORT=8080
ASTRA_API_WORKERS=4

# Security
ASTRA_MASTER_KEY=  # Generate with: openssl rand -hex 32
ASTRA_OWNER_ID=saint_lucid
ASTRA_ALLOWED_ORIGINS=http://localhost:3000

# Resource Limits
ASTRA_MAX_PROCESSES=10
ASTRA_MAX_MEMORY_MB=4096
ASTRA_MAX_DISK_GB=10

# Document Processing
ASTRA_CHUNK_SIZE=1000
ASTRA_OVERLAP_SIZE=200
ASTRA_VECTOR_DIMS=384  # BGE-M3 default

# Media Engine
ASTRA_SD_API_URL=http://127.0.0.1:7860
ASTRA_DAW_HOST=127.0.0.1
ASTRA_DAW_PORT=8000

# Paths
ASTRA_DATA_DIR=./data
ASTRA_CACHE_DIR=./cache
ASTRA_MODEL_DIR=./models

# Logging
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=json

# Feature Flags
ASTRA_ENABLE_GUI=true
ASTRA_ENABLE_PLUGINS=true
ASTRA_ENABLE_MEDIA=true