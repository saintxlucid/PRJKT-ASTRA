{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "Route Mix Overview",
      "type": "row",
      "collapsed": false,
      "panels": [
        {
          "title": "Request Distribution",
          "type": "piechart",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "sum by (mode) (astra_router_calls_total)",
              "legendFormat": "{{mode}}"
            }
          ]
        },
        {
          "title": "Evolution Phases",
          "type": "timeseries",
          "datasource": "Prometheus", 
          "targets": [
            {
              "expr": "rate(astra_router_evolution_phases_total[5m])",
              "legendFormat": "{{phase}}"
            }
          ]
        }
      ]
    },
    {
      "title": "Latency Overview",
      "type": "row",
      "collapsed": false,
      "panels": [
        {
          "title": "Tool Execution Latency",
          "type": "timeseries",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "histogram_quantile(0.5, rate(astra_tool_execution_duration_seconds_bucket[5m]))",
              "legendFormat": "p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(astra_tool_execution_duration_seconds_bucket[5m]))",
              "legendFormat": "p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(astra_tool_execution_duration_seconds_bucket[5m]))",
              "legendFormat": "p99"
            }
          ]
        },
        {
          "title": "Plan Generation Latency",
          "type": "gauge",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, rate(astra_plan_generation_duration_seconds_bucket[5m]))",
              "legendFormat": "p95"
            }
          ],
          "options": {
            "minValue": 0,
            "maxValue": 10,
            "thresholds": [
              { "value": 5, "color": "green" },
              { "value": 7, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      ]
    },
    {
      "title": "Consent & Budget",
      "type": "row",
      "collapsed": false,
      "panels": [
        {
          "title": "Consent Requests",
          "type": "timeseries",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "sum(rate(astra_consent_requests_total[5m])) by (status)",
              "legendFormat": "{{status}}"
            }
          ],
          "options": {
            "stableNaming": true
          }
        },
        {
          "title": "Budget Exhaustions",
          "type": "bargauge",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "sum(astra_budget_exhaustion_events_total) by (component)",
              "legendFormat": "{{component}}"
            }
          ]
        }
      ]
    },
    {
      "title": "OS Operations",
      "type": "row",
      "collapsed": false,
      "panels": [
        {
          "title": "OS Action Status",
          "type": "timeseries",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "sum(rate(astra_os_action_total[5m])) by (status)",
              "legendFormat": "{{status}}"
            }
          ]
        },
        {
          "title": "OSOP Actions",
          "type": "table",
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "sum(astra_osop_actions_total) by (capability, result)",
              "format": "table",
              "instant": true
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {},
                "indexByName": {
                  "capability": 0,
                  "result": 1,
                  "Value": 2
                },
                "renameByName": {
                  "Value": "Count"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["astra", "monitoring"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "ASTRA Operations Dashboard",
  "uid": "astra-ops",
  "version": 1
}